# APITemplate.io Direct URL credentials (Image Template Editor -> Direct URL tab)
# Server-side only — never prefix with NEXT_PUBLIC_
APITEMPLATE_TEMPLATE_ID=
APITEMPLATE_AUTH_CODE=

# Vercel Blob store token (Vercel Dashboard -> Storage -> Blob -> Connect to project)
# Auto-injected on Vercel deployments when a Blob store is linked; required for local dev
BLOB_READ_WRITE_TOKEN=
